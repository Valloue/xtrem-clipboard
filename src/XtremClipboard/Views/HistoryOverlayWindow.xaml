<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="XtremClipboard.Views.HistoryOverlayWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:XtremClipboard.ViewModels"
    Title="Xtrem Clipboard">

        <Grid x:Name="RootGrid" Background="{ThemeResource SolidBackgroundFillColorBaseBrush}" Padding="12" KeyDown="RootGrid_KeyDown">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,8">
            <TextBlock Text="Historique" Style="{StaticResource SubtitleTextBlockStyle}" VerticalAlignment="Center" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="6">
                <Button
                    MinWidth="0"
                    Padding="10,4"
                    Command="{x:Bind ViewModel.OpenSettingsCommand}"
                    AutomationProperties.Name="Réglages"
                    ToolTipService.ToolTip="Réglages">
                    <FontIcon Glyph="&#xE713;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16" />
                </Button>
                <Button Content="Fermer" MinWidth="0" Click="Close_Click" />
            </StackPanel>
        </Grid>

        <TextBox
            x:Name="SearchBox"
            Grid.Row="1"
            PlaceholderText="Rechercher…"
            Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
            KeyDown="RootGrid_KeyDown"
            Margin="0,0,0,8" />

        <ListView
            x:Name="EntriesList"
            Grid.Row="2"
            ItemsSource="{x:Bind ViewModel.Items, Mode=OneWay}"
            SelectedItem="{x:Bind ViewModel.SelectedItem, Mode=TwoWay}"
            Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
            SelectionMode="Single"
            IsItemClickEnabled="True"
            ScrollViewer.HorizontalScrollMode="Disabled"
            ScrollViewer.HorizontalScrollBarVisibility="Disabled"
            ItemClick="EntriesList_ItemClick"
            DoubleTapped="EntriesList_DoubleTapped">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Padding" Value="8,8" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="vm:HistoryItemViewModel">
                    <Grid RowSpacing="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border
                                Width="160"
                                Height="90"
                                Margin="0,0,10,0"
                                Visibility="{x:Bind IsImage}"
                                Background="#FFF3F3F3"
                                BorderBrush="#FFD0D0D0"
                                BorderThickness="1"
                                CornerRadius="4">
                                <Image Stretch="Uniform" Margin="2">
                                    <Image.Source>
                                        <BitmapImage UriSource="{x:Bind ThumbnailUri}" />
                                    </Image.Source>
                                </Image>
                            </Border>

                            <TextBlock
                                Grid.Column="1"
                                Text="{x:Bind Preview}"
                                Visibility="{x:Bind IsText}"
                                TextWrapping="Wrap"
                                MaxLines="4"
                                TextTrimming="CharacterEllipsis"
                                VerticalAlignment="Center" />
                        </Grid>

                        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="6">
                            <TextBlock
                                Text="{x:Bind TimeLabel}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                VerticalAlignment="Center"
                                Opacity="0.7"
                                Margin="0,0,4,0" />
                            <Button Content="Coller" MinWidth="0" Tag="{x:Bind}" Click="Paste_Click" Style="{StaticResource AccentButtonStyle}" Padding="8,4" />
                            <Button Content="Copier" MinWidth="0" Tag="{x:Bind}" Click="Copy_Click" Padding="8,4" />
                            <Button Content="{x:Bind PinLabel, Mode=OneWay}" MinWidth="0" Tag="{x:Bind}" Click="Pin_Click" Padding="8,4" />
                            <Button Content="Supprimer" MinWidth="0" Tag="{x:Bind}" Click="Delete_Click" Padding="8,4" />
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <TextBlock
            Grid.Row="3"
            Margin="0,8,0,0"
            Text="{x:Bind ViewModel.StatusText, Mode=OneWay}"
            Style="{StaticResource CaptionTextBlockStyle}"
            Opacity="0.75" />
    </Grid>
</Window>
